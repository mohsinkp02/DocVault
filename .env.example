# Secret key for Flask (change this for production)
SECRET_KEY=docvault-offline-storage-key-2026

# Permanent storage mode: Hugging Face Hub only
STORAGE_MODE=HF

# Hugging Face Settings (Required)
HF_TOKEN=hf_your_token_here
HF_REPO_ID=your_username/your_docvault_storage
HF_REPO_TYPE=dataset

# Spaces runtime port
PORT=7860
